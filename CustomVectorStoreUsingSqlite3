import sqlite3
import json
import math
import os
from openai import OpenAI

def cosine(a,b):
    p = sum(x*y for x, y in zip(a,b))
    q = math.sqrt(sum(x*x for x in a))
    r = math.sqrt(sum(y*y for y in b))
    cosine= p / (q + r)
    return(cosine)

query = "I removed a file by mistake, can I get it back?"


client= OpenAI(base_url =os.environ["OPENAI_BASE_URL"],
               api_key = os.environ["OPENAI_API_KEY"])
response=client.embeddings.create(
        model = "text-embedding-3-small",
        input = query)

dataembed = response.data[0].embedding

scored = []
db = sqlite3.connect("store.db")
for line, dump in db.execute("select text, embedding from docs"):
    vec = json.loads(dump)
    scored.append({"text":line,"score":round(cosine(dataembed,vec),3)})

scored.sort(key=lambda x:x['score'],reverse=True)
print(json.dumps(scored[:2]))
